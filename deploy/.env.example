# Copy this to .env on the mini PC, next to the real docker-compose.yml
# (NOT committed to git) and fill in a real value. `docker compose` reads it
# automatically when run from that directory.
#
# Generate a long random token, e.g. on Windows without relying on openssl
# being on PATH: docker run --rm alpine sh -c "head -c32 /dev/urandom | od -An -tx1 | tr -d ' \n'"
ANALYTICS_TOKEN=
